# Copy to .env and fill in real values. .env is git-ignored - never commit a real account key.
# Parsed as a Java properties file: no quotes, no "export", one KEY=VALUE per line.
# A '=' inside the base64 account key is fine; only the first '=' separates key from value.

AZURE_STORAGE_ACCOUNT_NAME=myaccount
AZURE_STORAGE_ACCOUNT_KEY=REPLACE_WITH_BASE64_ACCOUNT_KEY
# Optional: only needed for a sovereign cloud or a custom endpoint.
AZURE_STORAGE_ENDPOINT=

AZURE_INPUT_CONTAINER_NAME=inputcontainer
AZURE_OUTPUT_CONTAINER_NAME=outputcontainer
AZURE_STAGING_CONTAINER_NAME=stagingcontainer
