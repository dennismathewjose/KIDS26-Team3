# scripts/ — LOCAL DEVELOPMENT ONLY
#
#     cp scripts/.env.example scripts/.env       # then fill it in
#     python scripts/run_job.py --job job.json --env-file scripts/.env --check
#
# Not used in Azure. A deployed job gets its configuration from the container's app settings
# and its credential from managed identity, so no .env file is deployed.
#
# NEVER COMMIT THE FILLED FILE. `.env` and `.env.*` are gitignored (.gitignore:4-5) while
# `.env.example` is explicitly allowed through (line 6) — keep it that way.

# ─── Storage ────────────────────────────────────────────────────────────────
# Not a secret: it is already visible in every job URL. Used to reject a payload whose URLs
# name a different account than the credential is scoped to.
AZURE_STORAGE_ACCOUNT=sabiohackteam3

# 1 (default) = DefaultAzureCredential — managed identity. What production uses.
# 0 = fall back to the SAS token or account key below. Local development only.
USE_MANAGED_IDENTITY=1

# Preferred for local work: scoped to the containers you need and it expires. Needs Read on
# the input container and Write/Create on the output container.
AZURE_STORAGE_SAS_TOKEN=

# SECRET, and full access to the whole account with no expiry. Last resort — prefer the SAS
# token above. Never set this in a deployed environment.
AZURE_STORAGE_KEY=

# Per-operation timeout, seconds. Raise it if a guideline .docx is large or the link is slow.
BLOB_TIMEOUT_SECONDS=300

# ─── Logging ────────────────────────────────────────────────────────────────
# DEBUG is safe: the Azure SDK loggers are pinned to WARNING in run_job.py precisely so a
# raised level cannot dump the Authorization header into the job log.
LOG_LEVEL=INFO

# ─── Model access (EXTENSION POINT 2, not yet wired) ────────────────────────
# Keys belong in Key Vault, fetched at run start — never pasted here. Reaching the vault
# requires campus network or Cloudflare, per the endpoints doc.
# KEY_VAULT_URL=https://<vault-name>.vault.azure.net/
# MODEL_SECRET_NAME=<secret-name-in-key-vault>
